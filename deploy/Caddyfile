# Set ATTENDANCE_HOST to the real hostname. Caddy obtains/manages HTTPS.
{$ATTENDANCE_HOST} {
    reverse_proxy 127.0.0.1:4180 {
        # Single proxy deployment: overwrite, never preserve client-supplied XFF.
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        transport http {
            dial_timeout 3s
            response_header_timeout 30s
        }
    }
    # No access log: QR secrets live in fragments; avoid logging student identifiers.
}
