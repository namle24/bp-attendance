# Direct campus LAN only. IT supplies the hostname, reserved laptop IP and trusted certificate.
# These variables belong to Caddy's environment, not automatically to the app's .env.
{
    # A private laptop cannot normally satisfy public HTTP/TLS ACME challenges.
    auto_https disable_redirects
    admin off
    persist_config off
    servers {
        protocols h1 h2
    }
}

https://{$ATTENDANCE_HOST}:{$ATTENDANCE_PORT:8443} {
    bind {$LAPTOP_LAN_IP}
    tls {$ATTENDANCE_CERT_FILE} {$ATTENDANCE_KEY_FILE}
    reverse_proxy 127.0.0.1:4180 {
        # Caddy is the ONLY proxy. The client's headers cannot supply its own campus IP.
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        transport http {
            dial_timeout 3s
            response_header_timeout 30s
        }
    }
}
