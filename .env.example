# Student page listens only on the selected Wi-Fi IPv4 address.
PORT=4180
# TA page listens only on 127.0.0.1. Never forward this port.
ADMIN_PORT=4181
# Blank: automatically select the only Wi-Fi interface with an IPv4 address.
# npm start opens a local network picker when ambiguous. Override is optional.
LAN_INTERFACE=
# Blank: use the selected interface's current subnet. Recomputed at startup.
# Optional explicit student CIDRs only when confirmed with USTH IT.
CAMPUS_CIDRS=
BP_DATABASE=./data/web-live.sqlite
# Optional Google Sheets sync. No student Google login is required.
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
