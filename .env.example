# Live mode refuses to start until required configuration is supplied.
BP_MODE=live
PORT=4180
BIND_HOST=127.0.0.1
PUBLIC_ORIGIN=
GOOGLE_CLIENT_ID=
# Exact Google Workspace hd values, provided by USTH IT; comma separated.
GOOGLE_HOSTED_DOMAINS=
ADMIN_EMAILS=
# Source CIDRs seen by the server, confirmed by IT: LAN ranges for laptop/LAN;
# public egress ranges for Internet hosting. Include IPv4/IPv6 as applicable; do not guess.
CAMPUS_CIDRS=
# Only the reverse proxy directly in front of Node; with the supplied Caddyfile:
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BP_DATABASE=./data/web-live.sqlite
