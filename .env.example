# Startup requires the complete Google, HTTPS and campus network configuration.
PORT=4180
BIND_HOST=127.0.0.1
# Laptop HTTPS origin includes :8443 and has no trailing slash.
PUBLIC_ORIGIN=
GOOGLE_CLIENT_ID=
# Exact Google Workspace hd values, provided by USTH IT; comma separated.
GOOGLE_HOSTED_DOMAINS=
ADMIN_EMAILS=
# Student LAN source CIDRs confirmed by IT. Include IPv4/IPv6 as applicable.
CAMPUS_CIDRS=
# Only the reverse proxy directly in front of Node; with the supplied Caddyfile:
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BP_DATABASE=./data/web-live.sqlite
