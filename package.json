{
  "name": "bp-attendance",
  "version": "0.4.0",
  "private": true,
  "description": "USTH BP attendance — LAN form, seat and duplicate-IP review, SQLite and Sheets",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "start": "node --env-file-if-exists=.env web/server.cjs",
    "bench:web": "node scripts/bench-web.cjs",
    "lan:probe": "node scripts/lan-probe.cjs",
    "laptop:prepare": "node scripts/prepare-laptop.cjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.cjs",
    "caddy:install": "node scripts/install-caddy.cjs",
    "laptop:setup": "node scripts/laptop-setup.cjs && node scripts/prepare-laptop.cjs",
    "host:check": "node scripts/host-check.cjs --report",
    "host:install": "node scripts/host-control.cjs install",
    "host:start": "node scripts/host-control.cjs start",
    "host:stop": "node scripts/host-control.cjs stop",
    "host:status": "node scripts/host-control.cjs status",
    "campus:test": "node scripts/campus-test.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "csv-parse": "6.2.1",
    "express": "5.2.1",
    "google-auth-library": "10.9.1",
    "ipaddr.js": "2.5.0"
  }
}
